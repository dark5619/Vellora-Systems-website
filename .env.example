# Authorized inquiry endpoint (POST application/json). When unset, the Contact form hands off
# an explicitly labelled email draft instead.
# VITE_INQUIRY_ENDPOINT=https://example.com/api/inquiries

# Address used for the email-draft hand-off (defaults to hello@vellorasystems.com from the design).
# VITE_INQUIRY_EMAIL=hello@vellorasystems.com
